DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require"
BETTER_AUTH_SECRET="your_better_auth_secret"
# No trailing slash (or we normalize — trailing slash in CLIENT_URL used to break Origin match).
BETTER_AUTH_URL="http://localhost:5000"
CLIENT_URL="http://localhost:3000"
# Optional: comma/space-separated extra origins (e.g. https://your-app.vercel.app, preview URLs).
# TRUSTED_ORIGINS="https://ecospark-web.vercel.app"
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
PORT=5000
NODE_ENV=development

